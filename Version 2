import logging
import time
from datetime import datetime, timedelta, timezone
from typing import List, Optional

import requests
from fastapi import FastAPI
from sqlalchemy import (
    create_engine,
    Column,
    String,
    DateTime,
    Float,
    ForeignKey,
)
from sqlalchemy.orm import declarative_base, relationship, sessionmaker

# =====================================================
# CONFIG
# =====================================================

DODO_IS_BASE_URL = "https://api.dodois.io/dodopizza/ru"
DODO_IS_TOKEN = "token nuzhen"

DODO_UNITS = [
    "000d3a2480c3810e11e7bd751c665f09",
    "000d3a39d824a82e11e9dacc71d4cdf1",
    # остальные UUID без изменений
]

RETENTION_DAYS = 60
SYNC_INTERVAL_SECONDS = 24 * 60 * 60
DATABASE_URL = "sqlite:///./supplies.db"

# =====================================================
# LOGGING
# =====================================================

logging.basicConfig(
    level=logging.INFO,
    format="%(asctime)s | %(levelname)s | %(message)s",
)
logger = logging.getLogger("dodo-sync")

# =====================================================
# DATABASE
# =====================================================

engine = create_engine(
    DATABASE_URL,
    connect_args={"check_same_thread": False},
)
SessionLocal = sessionmaker(bind=engine)
Base = declarative_base()


class IncomingStockOrder(Base):
    __tablename__ = "incoming_stock_orders"

    id = Column(String, primary_key=True)
    unitId = Column(String)
    unitName = Column(String)
    suppliedAtLocal = Column(DateTime(timezone=True))

    items = relationship(
        "StockItem",
        back_populates="order",
        cascade="all, delete-orphan",
    )


class StockItem(Base):
    __tablename__ = "stock_items"

    id = Column(String, primary_key=True)
    orderId = Column(String, ForeignKey("incoming_stock_orders.id"))
    name = Column(String)
    quantity = Column(Float)
    measurementUnit = Column(String)

    order = relationship("IncomingStockOrder", back_populates="items")


class SyncState(Base):
    __tablename__ = "sync_state"

    id = Column(String, primary_key=True, default="state")
    initializedAt = Column(DateTime(timezone=True))
    lastDailySync = Column(DateTime(timezone=True))


Base.metadata.create_all(bind=engine)

# =====================================================
# TIME UTILS
# =====================================================

def parse_dt(value: str) -> datetime:
    dt = datetime.fromisoformat(value)
    return dt if dt.tzinfo else dt.replace(tzinfo=timezone.utc)


# =====================================================
# ❗❗❗ МЕСТО ДЛЯ ТЕСТОВ ❗❗❗
# =====================================================
# Для тестирования можешь зафиксировать дату, например:
# return datetime(2024, 12, 15, tzinfo=timezone.utc)

def get_now() -> datetime:
    return datetime.now(timezone.utc)

# =====================================================
# DODO IS CLIENT
# =====================================================

class DodoISClient:
    def __init__(self):
        self.base_url = DODO_IS_BASE_URL
        self.headers = {
            "Authorization": f"Bearer {DODO_IS_TOKEN}",
            "Accept": "application/json",
        }

    def get_supplies(
        self,
        from_date: datetime,
        to_date: datetime,
        unit: str,
    ) -> List[dict]:
        skip = 0
        result: List[dict] = []

        while True:
            response = requests.get(
                f"{self.base_url}/accounting/incoming-stock-items/by-supply",
                params={
                    "from": from_date.strftime("%Y-%m-%dT%H:%M:%S"),
                    "to": to_date.strftime("%Y-%m-%dT%H:%M:%S"),
                    "units": unit,
                    "skip": skip,
                    "take": 50,
                },
                headers=self.headers,
            )
            response.raise_for_status()
            data = response.json()

            batch = data.get("result", [])
            if not batch:
                break

            result.extend(batch)

            if data.get("isEndOfListReached", True):
                break

            skip += len(batch)

        return result

    def get_supply_by_id(self, supply_id: str) -> Optional[dict]:
        response = requests.get(
            f"{self.base_url}/accounting/incoming-stock-items/by-supply/{supply_id}",
            headers=self.headers,
        )
        if response.status_code == 404:
            return None
        response.raise_for_status()
        return response.json()

# =====================================================
# DB HELPERS
# =====================================================

def save_new_supplies(db, supplies: List[dict]):
    for supply in supplies:
        supply_id = supply.get("supplyId")
        if not supply_id:
            continue

        exists = (
            db.query(IncomingStockOrder)
            .filter(IncomingStockOrder.id == supply_id)
            .first()
        )
        if exists:
            continue

        order = IncomingStockOrder(
            id=supply_id,
            unitId=supply.get("unitId"),
            unitName=supply.get("unitName"),
            suppliedAtLocal=parse_dt(supply.get("suppliedAtLocal")),
        )

        for item in supply.get("items", []):
            order.items.append(
                StockItem(
                    id=item.get("id"),
                    name=item.get("name"),
                    quantity=item.get("quantity", 0),
                    measurementUnit=item.get("measurementUnit"),
                )
            )

        db.add(order)

# =====================================================
# SYNC LOGIC
# =====================================================

def initial_sync(db, client):
    logger.info("Initial sync for last 60 days")

    now = get_now()
    from_date = now - timedelta(days=RETENTION_DAYS)

    for unit in DODO_UNITS:
        supplies = client.get_supplies(from_date, now, unit)
        save_new_supplies(db, supplies)

    db.add(
        SyncState(
            initializedAt=now,
            lastDailySync=now,
        )
    )


def daily_sync(db, client):
    now = get_now()
    today = now.replace(hour=0, minute=0, second=0, microsecond=0)

    from_date = today - timedelta(days=1)
    to_date = today

    logger.info(f"Syncing yesterday: {from_date.date()}")

    for unit in DODO_UNITS:
        supplies = client.get_supplies(from_date, to_date, unit)
        save_new_supplies(db, supplies)


def cleanup_old(db):
    cutoff = get_now() - timedelta(days=RETENTION_DAYS)

    deleted = (
        db.query(IncomingStockOrder)
        .filter(IncomingStockOrder.suppliedAtLocal < cutoff)
        .delete(synchronize_session=False)
    )

    logger.info(f"Deleted {deleted} old supplies")


def compare_supply(db_supply, api_supply):
    diffs = []

    if db_supply.unitName != api_supply.get("unitName"):
        diffs.append(
            f"unitName: DB={db_supply.unitName} API={api_supply.get('unitName')}"
        )

    db_items = {
        i.id: (i.quantity, i.measurementUnit)
        for i in db_supply.items
    }

    api_items = {
        i["id"]: (i["quantity"], i["measurementUnit"])
        for i in api_supply.get("items", [])
    }

    for item_id in db_items.keys() | api_items.keys():
        if db_items.get(item_id) != api_items.get(item_id):
            diffs.append(
                f"Item {item_id}: DB={db_items.get(item_id)} API={api_items.get(item_id)}"
            )

    return diffs


def audit_all(db, client):
    logger.info("Auditing supplies")

    supplies = db.query(IncomingStockOrder).all()

    for supply in supplies:
        api_supply = client.get_supply_by_id(supply.id)
        if not api_supply:
            logger.warning(f"Supply {supply.id} missing in API")
            continue

        diffs = compare_supply(supply, api_supply)
        if diffs:
            logger.warning(f"⚠️ Supply {supply.id} changed:")
            for d in diffs:
                logger.warning(f"   - {d}")

# =====================================================
# MAIN SYNC JOB
# =====================================================

def sync_job():
    db = SessionLocal()
    client = DodoISClient()

    try:
        state = db.query(SyncState).first()

        if not state:
            initial_sync(db, client)
        else:
            daily_sync(db, client)
            cleanup_old(db)
            audit_all(db, client)
            state.lastDailySync = get_now()

        db.commit()

    except Exception:
        db.rollback()
        logger.exception("SYNC FAILED")

    finally:
        db.close()

# =====================================================
# FASTAPI
# =====================================================

app = FastAPI()

@app.on_event("startup")
def on_startup():
    logger.info("Application started")

    while True:
        sync_job()
        logger.info(f"Sleeping {SYNC_INTERVAL_SECONDS} seconds")
        time.sleep(SYNC_INTERVAL_SECONDS)

@app.get("/")
def healthcheck():
    return {"status": "ok"}
