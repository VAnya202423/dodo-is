SessionLocal = sessionmaker(bind=engine)
Base = declarative_base()


class SyncStatus(Base):
    __tablename__ = "sync_status"
    id = Column(Integer, primary_key=True)
    last_sync = Column(DateTime(timezone=True), nullable=False)


class IncomingStockOrder(Base):
    __tablename__ = "incoming_stock_orders"

    id = Column(String, primary_key=True)
    unit_id = Column(String, nullable=False)
    unit_name = Column(String, nullable=False)
    supplied_at = Column(DateTime(timezone=True), nullable=False)

    items = relationship(
        "StockItem",
        back_populates="order",
        cascade="all, delete-orphan",
    )


class StockItem(Base):
    __tablename__ = "stock_items"

    id = Column(Integer, primary_key=True, autoincrement=True)
    external_id = Column(String, nullable=False)
    order_id = Column(
        String,
        ForeignKey("incoming_stock_orders.id", ondelete="CASCADE"),
        nullable=False,
    )
    name = Column(String, nullable=False)
    quantity = Column(Float, nullable=False)
    measurement_unit = Column(String, nullable=False)
    total_price_with_vat = Column(Float)
    total_price_without_vat = Column(Float)

    order = relationship("IncomingStockOrder", back_populates="items")

    __table_args__ = (
        UniqueConstraint(
            "external_id",
            "order_id",
            name="uq_stockitem_external_order",
        ),
    )


Base.metadata.create_all(bind=engine)

# =====================================================
# UTILS
# =====================================================
def now_utc() -> datetime:
    return datetime.now(timezone.utc)


def parse_dt(value: str) -> datetime:
    if value.endswith("Z"):
        value = value.replace("Z", "+00:00")
    return datetime.fromisoformat(value).astimezone(timezone.utc)


@contextmanager
def get_db():
    db = SessionLocal()
    try:
        yield db
    finally:
        db.close()


# =====================================================
# DODO IS CLIENT
# =====================================================
class DodoISClient:
    def __init__(self):
        self.headers = {
            "Authorization": f"Bearer {DODO_IS_TOKEN}",
            "Accept": "application/json",
        }

    def get_supplies(
        self,
        from_date: datetime,
        to_date: datetime,
        unit_id: str,
    ) -> List[Dict]:

        skip = 0
        result = []

        while True:
            try:
                r = requests.get(
                    f"{DODO_IS_BASE_URL}/accounting/incoming-stock-items/by-supply",
                    headers=self.headers,
                    params={
                        "from": from_date.strftime("%Y-%m-%dT%H:%M:%S"),
                        "to": to_date.strftime("%Y-%m-%dT%H:%M:%S"),
                        "units": unit_id,
                        "skip": skip,
                        "take": 50,
                    },
                    timeout=60,
                )
                r.raise_for_status()
            except requests.RequestException as e:
                logger.error(f"API ERROR for unit {unit_id}: {e}")
                break

            data = r.json()
            batch = data.get("result", [])

            if not batch:
                break

            result.extend(batch)

            if data.get("isEndOfListReached"):
                break

            skip += len(batch)

        return result


# =====================================================
# SYNC
# =====================================================
def sync_supplies(db, client: DodoISClient):
    logger.info("===== SYNC STARTED =====")

    try:
        status = db.query(SyncStatus).first()

        if not status:
            from_date = now_utc() - timedelta(days=RETENTION_DAYS)
            status = SyncStatus(last_sync=from_date)
            db.add(status)
            db.commit()
        else:
            from_date = status.last_sync

        to_date = now_utc()
        logger.info(f"SYNC range: {from_date} → {to_date}")

        for unit in DODO_UNITS:
            supplies = client.get_supplies(from_date, to_date, unit)
            logger.info(f"SYNC: {len(supplies)} supplies for unit {unit}")

            for s in supplies:
                order_id = s["incomingStockOrderId"]

                order = db.get(IncomingStockOrder, order_id)
                if not order:
                    order = IncomingStockOrder(
                        id=order_id,
                        unit_id=s["unitId"],
                        unit_name=s["unitName"],
                        supplied_at=parse_dt(s["suppliedAtLocal"]),
                    )
                    db.add(order)

                for item in s.get("stockItems", []):
                    ext_id = item["id"]

                    stock_item = (
                        db.query(StockItem)
                        .filter_by(order_id=order_id, external_id=ext_id)
                        .first()
                    )

                    if stock_item:
                        stock_item.quantity = item.get("quantity", 0)
                        stock_item.total_price_with_vat = item.get("totalPriceWithVat")
                        stock_item.total_price_without_vat = item.get("totalPriceWithoutVat")
                    else:
                        db.add(
                            StockItem(
                                external_id=ext_id,
                                order=order,
                                name=item["name"],
                                quantity=item.get("quantity", 0),
                                measurement_unit=item["measurementUnit"],
                                total_price_with_vat=item.get("totalPriceWithVat"),
                                total_price_without_vat=item.get("totalPriceWithoutVat"),
                            )
                        )

        status.last_sync = to_date
        db.commit()

        cutoff = now_utc() - timedelta(days=RETENTION_DAYS)
        old_orders = (
            db.query(IncomingStockOrder)
            .filter(IncomingStockOrder.supplied_at < cutoff)
            .all()
        )
        for o in old_orders:
            db.delete(o)

        db.commit()

    except Exception as e:
        db.rollback()
        logger.exception("SYNC FAILED: %s", e)

    logger.info("===== SYNC FINISHED =====")


# =====================================================
# AUDIT
# =====================================================
def get_audit_data(db, client: DodoISClient):
    """
    Возвращает список отклонений для фронтенда
    """
    results = []
    try:
        db_orders = db.query(IncomingStockOrder).all()
        if not db_orders:
            return results

        orders_by_unit: Dict[str, List[IncomingStockOrder]] = {}
        for order in db_orders:
            orders_by_unit.setdefault(order.unit_id, []).append(order)

        from_date = now_utc() - timedelta(days=RETENTION_DAYS)
        to_date = now_utc()

        for unit_id, unit_orders in orders_by_unit.items():
            api_supplies = client.get_supplies(from_date, to_date, unit_id)

            api_map = {
                s["incomingStockOrderId"]: s
                for s in api_supplies
            }

            for order in unit_orders:
                api_order = api_map.get(order.id)
                if not api_order:
                    continue

                db_items = {
                    i.external_id: i
                    for i in order.items
                }

                for item in api_order.get("stockItems", []):
                    db_item = db_items.get(item["id"])
                    if not db_item:
                        continue

                    # считаем отклонение цены
                    price = db_item.total_price_with_vat or 0
                    avg_price = item.get("totalPriceWithVat") or 0
                    deviation = 0
                    if avg_price:
                        deviation = (price - avg_price) / avg_price * 100

                    results.append({
                        "date": order.supplied_at.strftime("%d.%m.%Y"),
                        "unit_name": order.unit_name,
                        "product": db_item.name,
                        "unit": db_item.measurement_unit,
                        "price": price,
                        "average": avg_price,
                        "deviation": round(deviation, 1),
                        "units_count": 1,
                        "invoice": order.id,
                    })
    except Exception as e:
        db.rollback()
        logger.exception("AUDIT FAILED: %s", e)

    return results


