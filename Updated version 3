app = FastAPI()


@app.on_event("startup")
def startup():
    def loop():
        client = DodoISClient()
        while True:
            with get_db() as db:
                sync_supplies(db, client)
            time.sleep(SYNC_INTERVAL_SECONDS)

    threading.Thread(target=loop, daemon=True).start()


@app.get("/api/sync-status")
def api_sync_status():
    with get_db() as db:
        status = db.query(SyncStatus).first()
        return {"last_sync": status.last_sync.strftime("%d.%m.%Y %H:%M") if status else None}


@app.get("/api/audit")
def api_audit():
    client = DodoISClient()
    with get_db() as db:
        data = get_audit_data(db, client)
        return JSONResponse(data)


