engine = create_engine(
    DATABASE_URL,
    connect_args={"check_same_thread": False},
)
SessionLocal = sessionmaker(bind=engine)
Base = declarative_base()

class IncomingStockOrder(Base):
    __tablename__ = "incoming_stock_orders"
    id = Column(String, primary_key=True)
    unitId = Column(String)
    unitName = Column(String)
    suppliedAtLocal = Column(DateTime(timezone=True))

    items = relationship(
        "StockItem",
        back_populates="order",
        cascade="all, delete-orphan",
    )

class StockItem(Base):
    __tablename__ = "stock_items"
    id = Column(String, primary_key=True)
    orderId = Column(String, ForeignKey("incoming_stock_orders.id"))
    name = Column(String)
    quantity = Column(Float)
    measurementUnit = Column(String)

    order = relationship("IncomingStockOrder", back_populates="items")

Base.metadata.create_all(bind=engine)

# =====================================================
# UTILS
# =====================================================

def now_utc() -> datetime:
    return datetime.now(timezone.utc)

def parse_dt(value: str) -> datetime:
    return datetime.fromisoformat(value).replace(tzinfo=timezone.utc)

def chunks(lst, size=30):
    for i in range(0, len(lst), size):
        yield lst[i:i + size]

# =====================================================
# DODO IS CLIENT
# =====================================================

class DodoISClient:
    def __init__(self):
        self.base_url = DODO_IS_BASE_URL
        self.headers = {
            "Authorization": f"Bearer {DODO_IS_TOKEN}",
            "Content-Type": "application/json",
            "Accept": "application/json",
        }

    def get_supplies(self, from_date: datetime, to_date: datetime, unit: str) -> List[dict]:
        skip = 0
        result: List[dict] = []

        while True:
            logger.info(f"Fetching supplies for unit: {unit}, skip={skip}")

            try:
                from_date_str = from_date.strftime("%Y-%m-%dT%H:%M:%S")
                to_date_str = to_date.strftime("%Y-%m-%dT%H:%M:%S")

                response = requests.get(
                    f"{self.base_url}/accounting/incoming-stock-items/by-supply",
                    params={
                        "from": from_date_str,
                        "to": to_date_str,
                        "units": unit,  # Используем только один UUID
                        "skip": skip,
                        "take": 10  # Ограничиваем количество данных
                    },
                    headers=self.headers,
                )
                response.raise_for_status()
                data = response.json()

                # Логируем URL запроса и параметры
                logger.info(f"Request URL: {response.url}")
                logger.info(f"Request Params: {response.request.body}")

            except requests.HTTPError as e:
                logger.error(f"HTTP Error: {e}")
                logger.error(f"Response Text: {response.text}")  # Логируем текст ошибки
                break
            except Exception as e:
                logger.exception("Unexpected error: %s", e)
                break

            batch = data.get("result", [])
            if not batch:
                break

            result.extend(batch)

            if data.get("isEndOfListReached", True):
                break

            skip += len(batch)

        logger.info(f"Total supplies fetched for unit {unit}: {len(result)}")
        return result

# =====================================================
# SYNC JOB
# =====================================================

def sync_job():
    logger.info("===== SYNC JOB STARTED =====")

    db = SessionLocal()
    client = DodoISClient()

    try:
        # Используем список всех юнитов
        for unit in DODO_UNITS:
            # Получаем дату за последний день
            to_date = now_utc()
            from_date = to_date - timedelta(days=RETENTION_DAYS)

            supplies = client.get_supplies(from_date, to_date, unit)

            for supply in supplies:
                supply_id = supply.get("supplyId")
                if not supply_id:
                    continue

                exists = (
                    db.query(IncomingStockOrder)
                    .filter(IncomingStockOrder.id == supply_id)
                    .first()
                )
                if exists:
                    continue

                order = IncomingStockOrder(
                    id=supply_id,
                    unitId=supply.get("unitId"),
                    unitName=supply.get("unitName"),
                    suppliedAtLocal=parse_dt(supply.get("suppliedAtLocal", now_utc().isoformat())),
                )

                for item in supply.get("items", []):
                    order.items.append(
                        StockItem(
                            id=item.get("id"),
                            name=item.get("name"),
                            quantity=item.get("quantity", 0),
                            measurementUnit=item.get("measurementUnit"),
                        )
                    )

                db.add(order)

        db.commit()

        logger.info("===== SYNC FINISHED =====")

    except Exception as e:
        logger.exception("SYNC FAILED: %s", e)

    finally:
        db.close()


# =====================================================
# RUN BACKGROUND SYNC
# =====================================================

app = FastAPI()

@app.on_event("startup")
def on_startup():
    logger.info("===== Application Started =====")
    while True:
        sync_job()
        logger.info(f"Sleeping for {SYNC_INTERVAL_SECONDS} seconds...")
        time.sleep(SYNC_INTERVAL_SECONDS)

